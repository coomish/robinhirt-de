---
import { href } from '../lib/base';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const { title, description, path = '/', jsonLd, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://example.invalid');
const canonical = new URL(href(path), site).href;
const ogImage = new URL(href('/og.png'), site).href;
---

<!doctype html>
<html lang="de" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Entwurf: bis zur Freigabe nicht indexieren */}
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#f4f6f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1316" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="preload"
      href={href('/fonts/instrument-sans-latin-wght-normal.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={href('/fonts/jetbrains-mono-latin-wght-normal.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      try {
        var s = localStorage.getItem('schema');
        if (s === 'dark' || s === 'light') document.documentElement.dataset.theme = s;
      } catch (e) {}
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="page">
      <a class="skip" href="#inhalt">Zum Inhalt</a>
      <header class="top">
        <a href={href('/')}>Robin Hirt</a>
        <button class="schema" type="button" data-schema aria-label="Farbschema wechseln">
          Schema
        </button>
      </header>
      <slot />
      <footer class="row foot">
        <div class="axis"><p class="mono" aria-hidden="true">EN</p></div>
        <div class="content">
          <p lang="en">
            Dr.-Ing. Robin Hirt is an entrepreneur who has worked on applied AI for more than ten
            years. He founded prenode, an industrial AI company based in Karlsruhe, in 2018 and
            holds a doctorate in applied AI from KIT.
          </p>
          <nav aria-label="Rechtliches" class="mono">
            <a href={href('/impressum')}>Impressum</a>
            <a href={href('/datenschutz')}>Datenschutz</a>
            <span>Keine Cookies, kein Tracking.</span>
          </nav>
        </div>
      </footer>
    </div>
    <script>
      const root = document.documentElement;
      const btn = document.querySelector<HTMLButtonElement>('[data-schema]');
      const system = matchMedia('(prefers-color-scheme: dark)');
      const current = () => root.dataset.theme ?? (system.matches ? 'dark' : 'light');
      const label = () => {
        if (!btn) return;
        const c = current();
        btn.textContent = c === 'dark' ? 'Dunkel' : 'Hell';
        btn.setAttribute('aria-label', `Farbschema wechseln, aktuell ${c === 'dark' ? 'dunkel' : 'hell'}`);
      };
      btn?.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('schema', next);
        } catch {}
        label();
      });
      system.addEventListener('change', label);
      label();
    </script>
  </body>
</html>
