---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { href } from '../lib/base';

const title = 'Robin Hirt – Unternehmer, Gründer von prenode, Karlsruhe';
const description =
  'Dr.-Ing. Robin Hirt, Unternehmer aus Karlsruhe. Seit über zehn Jahren arbeitet er an künstlicher Intelligenz, die im Betrieb funktionieren muss. Gründer von prenode.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Robin Hirt',
  honorificPrefix: 'Dr.-Ing.',
  givenName: 'Robin',
  familyName: 'Hirt',
  jobTitle: 'Unternehmer',
  description,
  address: { '@type': 'PostalAddress', addressLocality: 'Karlsruhe', addressCountry: 'DE' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Karlsruher Institut für Technologie' },
  founder: { '@type': 'Organization', name: 'prenode', url: 'https://www.prenode.de' },
  sameAs: [
    'https://www.linkedin.com/in/robinhirt/',
    'https://scholar.google.com/citations?user=623r60sAAAAJ',
    'https://www.prenode.de',
  ],
};

const auftritte = [
  { jahr: 2026, wo: 'KI-Connect, CyberForum Karlsruhe', thema: null, url: 'https://www.cyberforum.de/ki-connect' },
  { jahr: 2026, wo: 'AppSphere Innovation Day', thema: 'Jenseits der Maschine', url: null },
  { jahr: 2025, wo: 'IHK bei AppSphere', thema: 'KI in der Fertigung: Schnell. Praxisnah. Wirksam.', url: null },
  { jahr: 2024, wo: 'Hannover Messe', thema: 'Supervised Autonomy: mit KI dem Fachkräftemangel begegnen', url: null },
  { jahr: 2023, wo: 'Hannover Messe', thema: 'Neue Geschäftsmodelle wie Pay-per-Part mit Daten und KI', url: null },
  { jahr: 2021, wo: 'Handelsblatt KI Summit', thema: '', url: null },
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <main id="inhalt">
    <Hero />

    <section class="abschnitt" id="werdegang" aria-labelledby="h-werdegang">
      <div class="g werdegang">
        <h2 class="label" id="h-werdegang">Werdegang</h2>
        <article class="kapitel bauen">
          <h3 class="display">Bauen</h3>
          <p>Mit 16 habe ich mich als Softwareentwickler selbständig gemacht und Software für Unternehmen gebaut.</p>
        </article>
        <article class="kapitel forschen">
          <h3 class="display">Forschen</h3>
          <p>
            Seit 2015 arbeite ich mit künstlicher Intelligenz, zuerst in einem Projekt bei SAP während
            des Studiums am KIT. Von 2017 bis 2019 habe ich am KIT in angewandter KI promoviert und am
            MIT-IBM Watson AI Lab geforscht. Daraus sind rund 20
            <a href={href('/veroeffentlichungen')}>Veröffentlichungen</a> entstanden.
          </p>
        </article>
        <article class="kapitel gruenden">
          <h3 class="display">Gründen</h3>
          <p class="gross display">
            2018 habe ich <a href="https://www.prenode.de" rel="noopener">prenode</a> gegründet. Wir
            bringen KI und IoT in Maschinen und Fertigungslinien. Heute arbeiten dort rund 30 Menschen,
            gewachsen ohne Risikokapital.
          </p>
        </article>
      </div>
    </section>

    <section class="abschnitt" id="ueberzeugung" aria-labelledby="h-ueberzeugung">
      <div class="g ueberzeugung">
        <h2 class="label" id="h-ueberzeugung">Wovon ich überzeugt bin</h2>
        <p class="satz display s1">KI muss im Betrieb bestehen, nicht in der Demo.</p>
        <p class="satz display s2">KI vervielfacht das Wissen von Fachleuten, statt es zu ersetzen.</p>
        <p class="satz display s3">Wer zu lange pilotiert, verliert.</p>
      </div>
    </section>

    <section class="abschnitt" id="auftritte" aria-labelledby="h-auftritte">
      <div class="g">
        <h2 class="label" id="h-auftritte">Auftritte</h2>
        <ol class="auftritte">
          {
            auftritte.map((a) => (
              <li>
                <span class="mono jahr">{a.jahr}</span>
                <span class="wo">
                  {a.url ? (
                    <a href={a.url} rel="noopener">
                      {a.wo}
                    </a>
                  ) : (
                    a.wo
                  )}
                </span>
                <span class="thema">{a.thema === null ? <span class="todo">Thema folgt</span> : a.thema}</span>
              </li>
            ))
          }
        </ol>
        <p class="video-hinweis mono">Vortrag als Video: <span class="todo">Link folgt</span></p>
      </div>
    </section>

    <section class="abschnitt" id="belege" aria-labelledby="h-belege">
      <div class="g belege">
        <h2 class="label" id="h-belege">Belege</h2>
        <div class="spalte pub">
          <h3>Veröffentlichungen</h3>
          <ol class="refs">
            <li>
              <cite>Supervised Machine Learning in Service Systems: Deriving Insights from Distributed Data.</cite>
              <span class="meta">Dissertation, KIT, 2019.</span>
              <a class="mono" href="https://publikationen.bibliothek.kit.edu/1000099105" rel="noopener">KIT-Bibliothek</a>
            </li>
            <li>
              <cite>How to Conduct Rigorous Supervised Machine Learning in Information Systems Research: The Supervised Machine Learning Reportcard.</cite>
              <span class="meta">Communications of the AIS, 2021.</span>
              <a class="mono" href="https://doi.org/10.17705/1CAIS.04845" rel="noopener">DOI</a>
            </li>
            <li>
              <cite>Enabling inter-organizational analytics in business networks through meta machine learning.</cite>
              <span class="meta">Information Technology and Management, 2025.</span>
              <a class="mono" href="https://doi.org/10.1007/s10799-023-00399-7" rel="noopener">DOI</a>
            </li>
          </ol>
          <p class="mehr">
            <a href={href('/veroeffentlichungen')}>Alle Veröffentlichungen</a>, mit Zitationen bei
            <a href="https://scholar.google.com/citations?user=623r60sAAAAJ" rel="noopener">Google Scholar</a>.
          </p>
        </div>
        <div class="spalte preise">
          <h3>Auszeichnungen</h3>
          <ul class="kompakt">
            <li><span class="mono">2018</span> IBM Best Paper Award, HICSS</li>
            <li><span class="mono">2018, 2019</span> Lehrpreise des KIT</li>
            <li>
              <span class="mono">mit prenode</span> CyberChampions Award 2020, KI-Champion Baden-Württemberg
              2021, VDMA Startup the Future <span class="todo">2021/22</span>, Microsoft Intelligent
              Manufacturing Award 2023
            </li>
          </ul>
        </div>
        <div class="spalte lehre">
          <h3>Lehre</h3>
          <ul class="kompakt">
            <li><span class="mono">2025</span> Lehrauftrag an der Hector School des KIT</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="abschnitt schluss" id="kontakt" aria-labelledby="h-kontakt">
      <div class="g">
        <h2 class="label" id="h-kontakt">Kontakt</h2>
        <img
          class="schluss-foto"
          src={href('/ueber-1200.jpg')}
          srcset={`${href('/ueber-1200.jpg')} 1200w, ${href('/ueber-1536.jpg')} 1536w`}
          sizes="(max-width: 900px) 40vw, 16rem"
          width="1536"
          height="1024"
          alt="Robin Hirt im Profil, Schwarzweißfoto"
          loading="lazy"
          decoding="async"
        />
        <div class="schluss-text">
          <p class="display gross">Ich lebe in Karlsruhe, laufe viel und trainiere Karate.</p>
          <ul class="kompakt">
            <li><span class="mono">E-Mail</span> <span class="todo">Adresse folgt</span></li>
            <li>
              <span class="mono">LinkedIn</span>
              <a href="https://www.linkedin.com/in/robinhirt/" rel="noopener">linkedin.com/in/robinhirt</a>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  /* Werdegang: zwei Kapitel nebeneinander, prenode darunter als größtes */
  .kapitel h3 {
    font-size: var(--s2);
    margin-bottom: 0.6rem;
  }
  .kapitel p {
    max-width: 44ch;
  }
  .bauen {
    grid-column: 3 / 7;
  }
  .forschen {
    grid-column: 7 / 12;
  }
  .gruenden {
    grid-column: 3 / 12;
    margin-top: clamp(1.5rem, 4vh, 3rem);
  }
  .gruenden .gross {
    font-size: clamp(1.5rem, 1rem + 1.8vw, 2.6rem);
    line-height: 1.15;
    font-weight: 500;
    max-width: 30ch;
  }
  .gruenden h3 {
    font-size: var(--s3);
  }

  /* Überzeugungen: drei Sätze, versetzt, groß */
  .ueberzeugung .satz {
    font-size: clamp(1.8rem, 1rem + 3vw, 4.2rem);
    max-width: 16ch;
  }
  .s1 {
    grid-column: 3 / 11;
  }
  .s2 {
    grid-column: 5 / 13;
    margin-top: clamp(1rem, 3vh, 2.5rem);
  }
  .s3 {
    grid-column: 3 / 10;
    margin-top: clamp(1rem, 3vh, 2.5rem);
  }

  /* Auftritte: Jahr, Ort, Thema */
  .auftritte {
    grid-column: 3 / 12;
  }
  .auftritte li {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 1.4fr);
    column-gap: 1.2rem;
    padding-block: 0.7rem;
    border-top: var(--hairline) solid var(--raster);
    align-items: baseline;
  }
  .auftritte li:last-child {
    border-bottom: var(--hairline) solid var(--raster);
  }
  .auftritte .thema {
    color: var(--blei);
  }
  .video-hinweis {
    grid-column: 3 / 11;
    margin-top: 0.6rem;
  }

  /* Belege: drei Spalten */
  .belege .pub {
    grid-column: 3 / 8;
  }
  .belege .preise {
    grid-column: 8 / 11;
  }
  .belege .lehre {
    grid-column: 11 / 13;
  }
  .belege h3 {
    font-size: var(--s1);
    font-weight: 600;
    margin-bottom: 0.6rem;
  }
  .refs li {
    padding-block: 0.6rem;
    border-top: var(--hairline) solid var(--raster);
    font-size: var(--s0);
  }
  .refs cite {
    font-style: normal;
  }
  .refs .meta {
    display: block;
    color: var(--blei);
  }
  .refs .mono {
    display: inline-block;
    margin-top: 0.15rem;
  }
  .mehr {
    margin-top: 0.8rem;
    font-size: var(--s0);
  }
  .kompakt li {
    padding-block: 0.45rem;
    border-top: var(--hairline) solid var(--raster);
    font-size: var(--s0);
  }
  .kompakt .mono {
    display: block;
  }

  /* Schluss: kleines Foto, ein Satz, Kontakt */
  .schluss-foto {
    grid-column: 3 / 6;
    width: 100%;
    max-width: 16rem;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 18% 30%;
    filter: grayscale(1);
  }
  .schluss-text {
    grid-column: 6 / 12;
  }
  .schluss-text .gross {
    font-size: clamp(1.4rem, 1rem + 1.4vw, 2.2rem);
    line-height: 1.15;
    font-weight: 500;
    margin-bottom: 1.4rem;
    max-width: 24ch;
  }

  @media (max-width: 900px) {
    .auftritte li {
      grid-template-columns: 3.5rem minmax(0, 1fr);
    }
    .auftritte .thema {
      grid-column: 2;
    }
    .schluss-foto {
      max-width: 10rem;
    }
  }
</style>
