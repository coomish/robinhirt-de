---
import Base from '../layouts/Base.astro';

// Entwurfsseite zum Vergleich der drei Motive für den Kopf. Nicht verlinkt,
// nicht indexiert; vor der Veröffentlichung entfernen.
const motive = [
  {
    id: 'modell',
    name: 'Lernendes Modell',
    kurz: 'Ein Gauß-Prozess lernt eine verborgene Kurve aus verrauschten Punkten, zeigt Unsicherheit als Band und erkennt Ausreißer per Leave-one-out. Klick setzt Punkte.',
    link: '/',
  },
  {
    id: 'vorhersage',
    name: 'Vorhersage gegen Wirklichkeit',
    kurz: 'Ein chaotisches System (Lorenz) läuft als Spur, ein autoregressives Modell sagt 0,5 s voraus. Wo die Wirklichkeit die Vorhersage verfehlt, wird die Lücke Bernstein. Maus zieht die Spur.',
    link: '/?motiv=vorhersage',
  },
  {
    id: 'schwarm',
    name: 'Ordnung im Schwarm',
    kurz: 'Tausende Punkte wie Stare: Angst läuft als Welle durch den Schwarm, k-means findet die Gruppen. Maus jagt.',
    link: '/?motiv=schwarm',
  },
];
---

<Base title="Motive im Vergleich – Entwurf" description="Entwurfsseite: drei Motive für den Kopf der Seite." path="/motive" noindex>
  <main id="inhalt">
    <section class="row section">
      <div class="axis"><h2>Entwurf</h2></div>
      <div class="content">
        <p>
          Drei Motive für den Kopf, alle live gerechnet. Der Link öffnet jedes im echten Kopf der
          Startseite. Diese Seite ist nicht verlinkt und wird vor der Veröffentlichung entfernt.
        </p>
      </div>
    </section>
    {
      motive.map((m, i) => (
        <section class="row section motiv" aria-labelledby={`h-${m.id}`}>
          <div class="axis">
            <h2 id={`h-${m.id}`}>{i + 1} · {m.name}</h2>
          </div>
          <div class="content">
            <p>{m.kurz} <a href={m.link}>Im Kopf ansehen</a></p>
          </div>
          <div class="signal">
            <canvas data-motiv={m.id} tabindex="0" role="img" aria-label={m.name} />
          </div>
          <div class="axis" />
          <div class="content">
            <p class="mono werte" data-werte={m.id} />
            <p class="hinweis" data-hinweis={m.id} />
          </div>
        </section>
      ))
    }
  </main>
</Base>

<style>
  .motiv {
    row-gap: 1rem;
  }
  .signal {
    grid-column: 1 / -1;
    margin-inline: calc(-1 * var(--rand));
    border-top: var(--hairline) solid var(--raster);
    border-bottom: var(--hairline) solid var(--raster);
  }
  canvas {
    width: 100%;
    height: clamp(260px, 44vh, 460px);
    touch-action: pan-y;
    cursor: crosshair;
  }
  .werte {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.4rem;
  }
  .werte :global(b) {
    font-weight: 500;
    color: var(--graphit);
    display: inline-block;
    min-width: 3ch;
  }
  .hinweis {
    margin-top: 0.9rem;
    color: var(--blei);
    font-size: var(--s0);
    max-width: 68ch;
  }
</style>

<script>
  import { mountModel } from '../scripts/model';
  import { mountForecast } from '../scripts/forecast';
  import { mountSwarm } from '../scripts/swarm';
  const mounts = { modell: mountModel, vorhersage: mountForecast, schwarm: mountSwarm } as const;
  for (const [id, mount] of Object.entries(mounts)) {
    const canvas = document.querySelector<HTMLCanvasElement>(`[data-motiv="${id}"]`);
    if (!canvas) continue;
    mount(canvas, {
      werte: document.querySelector<HTMLElement>(`[data-werte="${id}"]`),
      hinweis: document.querySelector<HTMLElement>(`[data-hinweis="${id}"]`),
    });
  }
</script>
