---
const stationen = [
  { jahr: null, text: 'Mit 16 als Softwareentwickler selbständig gemacht.' },
  {
    jahr: '2011–16',
    text: 'Studium Information Engineering and Management am KIT, Auslandssemester an der Boğaziçi-Universität Istanbul.',
  },
  { jahr: '2015', text: 'Erstes KI-Projekt, bei SAP.' },
  { jahr: '2017–19', text: 'Promotion in angewandter KI am KIT.' },
  { jahr: '2018', text: 'prenode gegründet.' },
  { jahr: '2019', text: 'Visiting Scholar am MIT-IBM Watson AI Lab.' },
];
---

<ol class="timeline" data-timeline>
  <svg class="trace" aria-hidden="true" width="24" height="0" viewBox="0 0 24 0"><path d="" /></svg>
  {
    stationen.map((s) => (
      <li>
        <span class="year mono">{s.jahr ?? <span class="todo">Jahr folgt</span>}</span>
        <p>{s.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    position: relative;
    margin-top: 2rem;
  }
  .timeline li {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    column-gap: var(--spalt);
    padding-block: 0.9rem;
  }
  .timeline li:first-child {
    padding-top: 0;
  }
  .timeline li:last-child {
    padding-bottom: 0;
  }
  .year {
    text-align: right;
    position: relative;
    padding-right: 2rem;
    padding-top: 0.2rem;
    white-space: nowrap;
  }
  .year::after {
    content: '';
    position: absolute;
    right: -0.9rem;
    top: 0.45rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--papier);
    border: 1.5px solid var(--graphit);
    transition: background 0.3s;
  }
  li.is-passed .year::after {
    background: var(--graphit);
  }
  .timeline p {
    max-width: 60ch;
  }
  /* Spur: ohne JS eine gerade Linie, mit JS die gezogene Welle */
  .timeline::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--achse) + 0.9rem - 0.5px);
    border-left: 1.5px solid var(--graphit);
  }
  .timeline.is-ready::before {
    display: none;
  }
  .trace {
    position: absolute;
    top: 0;
    left: calc(var(--achse) + 0.9rem - 12px);
    width: 24px;
    pointer-events: none;
    display: none;
  }
  .timeline.is-ready .trace {
    display: block;
  }
  .trace path {
    fill: none;
    stroke: var(--graphit);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  @media (max-width: 900px) {
    .timeline {
      padding-left: 1.6rem;
      margin-top: 0;
    }
    .timeline li {
      row-gap: 0.15rem;
    }
    .year {
      text-align: left;
      padding-right: 0;
    }
    .year::after {
      right: auto;
      left: calc(-1.6rem - 4.5px);
      top: 0.5rem;
    }
    .timeline::before {
      left: -0.5px;
    }
    .trace {
      left: -12px;
    }
  }
</style>

<script>
  import { mountTimeline } from '../scripts/timeline';
  const el = document.querySelector<HTMLElement>('[data-timeline]');
  if (el) mountTimeline(el);
</script>
