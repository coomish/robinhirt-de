---
---

<section class="hero" aria-labelledby="name">
  <div class="buehne">
    <img
      class="buehne-foto"
      src="/buehne-1200.jpg"
      srcset="/buehne-1200.jpg 1200w, /buehne-1536.jpg 1536w"
      sizes="100vw"
      width="1536"
      height="1024"
      alt="Robin Hirt sitzt auf einem Hocker und blickt in die Kamera, Schwarzweißfoto"
      fetchpriority="high"
      decoding="async"
    />
    <div class="buehne-text">
      <h1 id="name">Dr.-Ing. Robin Hirt</h1>
      <p class="mono rolle">Gründer von prenode · Karlsruhe</p>
      <p class="kernsatz">
        Unternehmer. Seit über zehn Jahren arbeite ich an künstlicher Intelligenz, die im Betrieb
        funktionieren muss.
      </p>
    </div>
  </div>

  <div class="signal">
    <canvas
      data-signal
      tabindex="0"
      role="img"
      aria-label="Ein Modell lernt live eine verborgene Kurve aus verrauschten Punkten und zeigt seine Unsicherheit als Band"
      aria-describedby="signal-hilfe"
    ></canvas>
    <p id="signal-hilfe" class="visually-hidden">
      Klick oder Finger setzt eigene Punkte, Ziehen setzt mehrere. Tastatur: Leertaste fügt
      einen Messpunkt hinzu, Pfeil nach oben oder unten einen Ausreißer.
    </p>
  </div>

  <div class="row readout">
    <div class="axis">
      <p class="mono">Motiv <span data-motiv-nr>–</span>/3</p>
      <p class="mono"><a href="/?motiv=vorhersage" data-motiv-next>nächstes</a></p>
    </div>
    <div class="content">
      <p class="mono werte" data-ro="werte">
        <span>Punkte <b>–</b></span>
        <span>Ausreißer <b>–</b></span>
        <span>Unsicherheit <b>–</b></span>
        <span>Rechenzeit <b>–</b></span>
      </p>
      <p class="hinweis" data-ro="hinweis">
        Ein Gauß-Prozess lernt live eine verborgene Kurve; das Band ist seine Unsicherheit,
        Türkis, was nicht passt. Klick setzt Punkte. Synthetisch, gerechnet lokal im
        Browser.
      </p>
    </div>
  </div>
</section>

<style>
  /* Die Bühne: Foto über die volle Breite, der Kernsatz im freien Raum links */
  /* Der erste Bildschirm teilt sich: oben die Bühne, unten das Motiv */
  .buehne {
    position: relative;
    height: clamp(380px, 56svh, 640px);
    overflow: hidden;
    background: var(--papier);
  }
  .buehne-foto {
    position: absolute;
    top: 0;
    left: 0;
    width: 112%; /* etwas breiter, damit die Person weiter rechts sitzt */
    height: 100%;
    object-fit: cover;
    object-position: 50% 15%; /* Kopf bleibt auch bei breiten, flachen Fenstern im Bild */
    filter: grayscale(1);
  }
  :root[data-theme='dark'] .buehne-foto {
    filter: grayscale(1) brightness(0.42) contrast(1.15);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .buehne-foto {
      filter: grayscale(1) brightness(0.42) contrast(1.15);
    }
  }
  .buehne-text {
    position: absolute;
    left: var(--rand);
    bottom: clamp(1.5rem, 5vh, 3.5rem);
    max-width: min(38vw, 32rem);
  }
  h1 {
    font-size: var(--s2);
    font-weight: 600;
    letter-spacing: -0.005em;
  }
  .rolle {
    margin-top: 0.3rem;
    color: var(--graphit);
    opacity: 0.8;
  }
  .kernsatz {
    margin-top: 1.4rem;
    font-size: clamp(1.5rem, 0.6rem + 1.4vw + 1.2vh, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.018em;
    font-weight: 500;
    text-wrap: balance;
  }
  @media (max-width: 760px) {
    .buehne {
      height: auto;
    }
    .buehne-foto {
      position: static;
      width: 100%;
      height: clamp(280px, 48svh, 460px);
      object-position: 60% 30%;
    }
    .buehne-text {
      position: static;
      max-width: none;
      padding: 1.4rem var(--rand) 2rem;
    }
    canvas {
      height: clamp(260px, 44svh, 420px);
    }
  }
  .signal {
    border-top: var(--hairline) solid var(--raster);
    border-bottom: var(--hairline) solid var(--raster);
  }
  canvas {
    width: 100%;
    height: clamp(260px, calc(100svh - 4.2rem - clamp(380px, 56svh, 640px)), 520px);
    touch-action: pan-y;
    cursor: crosshair;
  }
  canvas:focus-visible {
    outline-offset: -3px;
  }
  .readout {
    padding-top: 0.9rem;
    padding-bottom: clamp(2rem, 6vh, 4rem);
  }
  .werte {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.4rem;
  }
  .werte b {
    font-weight: 500;
    color: var(--graphit);
    display: inline-block;
    min-width: 3ch;
  }
  .hinweis {
    margin-top: 0.9rem;
    color: var(--blei);
    font-size: var(--s0);
    max-width: 60ch;
  }
  .axis p + p {
    margin-top: 0.3rem;
  }
  @media (max-width: 900px) {
  </style>

<script>
  import type { UI, Unmount } from '../scripts/ui';
  const canvas = document.querySelector<HTMLCanvasElement>('[data-signal]');
  const ui: UI = {
    werte: document.querySelector<HTMLElement>('[data-ro="werte"]'),
    hinweis: document.querySelector<HTMLElement>('[data-ro="hinweis"]'),
  };
  const nr = document.querySelector<HTMLElement>('[data-motiv-nr]');
  const next = document.querySelector<HTMLAnchorElement>('[data-motiv-next]');
  const MOTIVE = ['modell', 'vorhersage', 'schwarm'] as const;
  type Motiv = (typeof MOTIVE)[number];
  const loaders: Record<Motiv, () => Promise<(c: HTMLCanvasElement, u: UI) => Unmount>> = {
    modell: () => import('../scripts/model').then((m) => m.mountModel),
    vorhersage: () => import('../scripts/forecast').then((m) => m.mountForecast),
    schwarm: () => import('../scripts/swarm').then((m) => m.mountSwarm),
  };
  if (canvas) {
    // Jeder Besuch bekommt ein zufälliges Motiv; ?motiv= legt es fest, „nächstes“ wechselt
    const wanted = new URLSearchParams(location.search).get('motiv') as Motiv | null;
    let current: number = wanted && MOTIVE.includes(wanted) ? MOTIVE.indexOf(wanted) : Math.floor(Math.random() * MOTIVE.length);
    let unmount: Unmount | null = null;
    let busy = false;
    async function show(i: number) {
      if (busy) return;
      busy = true;
      current = (i + MOTIVE.length) % MOTIVE.length;
      const mount = await loaders[MOTIVE[current]]();
      unmount?.();
      unmount = mount(canvas!, ui);
      if (nr) nr.textContent = String(current + 1);
      if (next) next.href = `/?motiv=${MOTIVE[(current + 1) % MOTIVE.length]}`;
      busy = false;
    }
    show(current);
    next?.addEventListener('click', (ev) => {
      ev.preventDefault();
      show(current + 1);
    });
  }
</script>
