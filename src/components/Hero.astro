---
---

<section class="hero" aria-labelledby="name">
  <div class="row hero-head">
    <div class="axis">
      <img
        class="portrait"
        src="/portrait-320.jpg"
        srcset="/portrait-320.jpg 320w, /portrait-640.jpg 640w"
        sizes="(max-width: 900px) 5.5rem, 9rem"
        width="640"
        height="800"
        alt="Porträt von Robin Hirt"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="content ident">
      <h1 id="name">Dr.-Ing. Robin Hirt</h1>
      <p class="mono rolle">Gründer von prenode · Karlsruhe</p>
    </div>
    <p class="kernsatz">
      Unternehmer. Seit über zehn Jahren arbeite ich an künstlicher Intelligenz, die im Betrieb
      funktionieren muss.
    </p>
  </div>

  <div class="signal">
    <canvas
      data-signal
      tabindex="0"
      role="img"
      aria-label="Ein Modell lernt live eine verborgene Kurve aus verrauschten Punkten und zeigt seine Unsicherheit als Band"
      aria-describedby="signal-hilfe"
    ></canvas>
    <p id="signal-hilfe" class="visually-hidden">
      Klick oder Finger setzt eigene Punkte, Ziehen setzt mehrere. Tastatur: Leertaste fügt
      einen Messpunkt hinzu, Pfeil nach oben oder unten einen Ausreißer.
    </p>
  </div>

  <div class="row readout">
    <div class="axis">
      <p class="mono">Motiv <span data-motiv-nr>–</span>/3</p>
      <p class="mono"><a href="/?motiv=vorhersage" data-motiv-next>nächstes</a></p>
    </div>
    <div class="content">
      <p class="mono werte" data-ro="werte">
        <span>Punkte <b>–</b></span>
        <span>Ausreißer <b>–</b></span>
        <span>Unsicherheit <b>–</b></span>
        <span>Rechenzeit <b>–</b></span>
      </p>
      <p class="hinweis" data-ro="hinweis">
        Ein Gauß-Prozess lernt live eine verborgene Kurve; der Fächer zeigt, was er für möglich
        hält, Bernstein, was nicht passt. Klick setzt Punkte. Synthetisch, gerechnet lokal im
        Browser.
      </p>
    </div>
  </div>
</section>

<style>
  .hero-head {
    padding-top: clamp(1.5rem, 6vh, 4rem);
    padding-bottom: clamp(1.5rem, 4vh, 2.5rem);
    row-gap: 1.6rem;
  }
  .hero-head .axis {
    grid-row: 1 / 3;
    align-self: end;
  }
  .portrait {
    width: 100%;
    max-width: 9rem;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  h1 {
    font-size: var(--s2);
    font-weight: 600;
    letter-spacing: -0.005em;
  }
  .rolle {
    margin-top: 0.3rem;
  }
  .kernsatz {
    grid-column: 2;
    font-size: clamp(1.75rem, 1.1rem + 2.6vw, 3rem);
    line-height: 1.12;
    letter-spacing: -0.018em;
    font-weight: 500;
    max-width: 24ch;
    text-wrap: balance;
  }
  .signal {
    border-top: var(--hairline) solid var(--raster);
    border-bottom: var(--hairline) solid var(--raster);
  }
  canvas {
    width: 100%;
    height: clamp(260px, 44vh, 460px);
    touch-action: pan-y;
    cursor: crosshair;
  }
  canvas:focus-visible {
    outline-offset: -3px;
  }
  .readout {
    padding-top: 0.9rem;
    padding-bottom: clamp(2rem, 6vh, 4rem);
  }
  .werte {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.4rem;
  }
  .werte b {
    font-weight: 500;
    color: var(--graphit);
    display: inline-block;
    min-width: 3ch;
  }
  .hinweis {
    margin-top: 0.9rem;
    color: var(--blei);
    font-size: var(--s0);
    max-width: 60ch;
  }
  .axis p + p {
    margin-top: 0.3rem;
  }
  @media (max-width: 900px) {
    .hero-head {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      column-gap: 1.1rem;
      row-gap: 1.4rem;
    }
    .hero-head .axis {
      grid-row: 1;
      align-self: center;
    }
    .ident {
      grid-column: 2;
      align-self: center;
    }
    .kernsatz {
      grid-column: 1 / -1;
      margin-top: 0.3rem;
    }
  }
</style>

<script>
  import type { UI, Unmount } from '../scripts/ui';
  const canvas = document.querySelector<HTMLCanvasElement>('[data-signal]');
  const ui: UI = {
    werte: document.querySelector<HTMLElement>('[data-ro="werte"]'),
    hinweis: document.querySelector<HTMLElement>('[data-ro="hinweis"]'),
  };
  const nr = document.querySelector<HTMLElement>('[data-motiv-nr]');
  const next = document.querySelector<HTMLAnchorElement>('[data-motiv-next]');
  const MOTIVE = ['modell', 'vorhersage', 'schwarm'] as const;
  type Motiv = (typeof MOTIVE)[number];
  const loaders: Record<Motiv, () => Promise<(c: HTMLCanvasElement, u: UI) => Unmount>> = {
    modell: () => import('../scripts/model').then((m) => m.mountModel),
    vorhersage: () => import('../scripts/forecast').then((m) => m.mountForecast),
    schwarm: () => import('../scripts/swarm').then((m) => m.mountSwarm),
  };
  if (canvas) {
    // Jeder Besuch bekommt ein zufälliges Motiv; ?motiv= legt es fest, „nächstes“ wechselt
    const wanted = new URLSearchParams(location.search).get('motiv') as Motiv | null;
    let current: number = wanted && MOTIVE.includes(wanted) ? MOTIVE.indexOf(wanted) : Math.floor(Math.random() * MOTIVE.length);
    let unmount: Unmount | null = null;
    let busy = false;
    async function show(i: number) {
      if (busy) return;
      busy = true;
      current = (i + MOTIVE.length) % MOTIVE.length;
      const mount = await loaders[MOTIVE[current]]();
      unmount?.();
      unmount = mount(canvas!, ui);
      if (nr) nr.textContent = String(current + 1);
      if (next) next.href = `/?motiv=${MOTIVE[(current + 1) % MOTIVE.length]}`;
      busy = false;
    }
    show(current);
    next?.addEventListener('click', (ev) => {
      ev.preventDefault();
      show(current + 1);
    });
  }
</script>
