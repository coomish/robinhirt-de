---
---

<section class="hero" aria-labelledby="name">
  <div class="row hero-head">
    <div class="axis">
      <img
        class="portrait"
        src="/portrait-320.jpg"
        srcset="/portrait-320.jpg 320w, /portrait-640.jpg 640w"
        sizes="(max-width: 900px) 5.5rem, 9rem"
        width="640"
        height="800"
        alt="Porträt von Robin Hirt"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="content ident">
      <h1 id="name">Dr.-Ing. Robin Hirt</h1>
      <p class="mono rolle">Gründer von prenode · Karlsruhe</p>
    </div>
    <p class="kernsatz">
      Unternehmer. Seit über zehn Jahren arbeite ich an künstlicher Intelligenz, die im Betrieb
      funktionieren muss.
    </p>
  </div>

  <div class="signal">
    <canvas
      data-signal
      tabindex="0"
      role="img"
      aria-label="Drei synthetische Messkanäle (Vibration, Temperatur, Strom) mit laufender Abweichungserkennung"
      aria-describedby="signal-hilfe"
    ></canvas>
    <p id="signal-hilfe" class="visually-hidden">
      Mit Maus oder Finger lässt sich jeder Kanal stören. Tastatur: Ziffern 1 bis 3 wählen den
      Kanal, Leertaste oder Pfeil nach oben stoßen ihn an, Pfeil nach unten nach unten.
    </p>
  </div>

  <div class="row readout">
    <div class="axis"><p class="mono">Signal</p></div>
    <div class="content">
      <p class="mono werte">
        <span>Vibration <b data-ro="v0">–</b></span>
        <span>Temperatur <b data-ro="v1">–</b></span>
        <span>Strom <b data-ro="v2">–</b></span>
        <span>Abweichungen <b data-ro="events">0</b></span>
      </p>
      <ol class="mono protokoll" data-ro="log" aria-label="Protokoll der letzten Abweichungen"></ol>
      <p class="hinweis">
        Synthetische Signale mit Rauschen, Drift und Ausreißern, die Kanäle sind gekoppelt. Die
        Erkennung, ein gleitender Mittelwert mit Toleranzband je Kanal, läuft lokal im Browser.
        Maus oder Finger stören einen Kanal; die anderen reagieren mit Verzögerung.
      </p>
    </div>
  </div>
</section>

<style>
  .hero-head {
    padding-top: clamp(1.5rem, 6vh, 4rem);
    padding-bottom: clamp(1.5rem, 4vh, 2.5rem);
    row-gap: 1.6rem;
  }
  .hero-head .axis {
    grid-row: 1 / 3;
    align-self: end;
  }
  .portrait {
    width: 100%;
    max-width: 9rem;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  h1 {
    font-size: var(--s2);
    font-weight: 600;
    letter-spacing: -0.005em;
  }
  .rolle {
    margin-top: 0.3rem;
  }
  .kernsatz {
    grid-column: 2;
    font-size: clamp(1.75rem, 1.1rem + 2.6vw, 3rem);
    line-height: 1.12;
    letter-spacing: -0.018em;
    font-weight: 500;
    max-width: 24ch;
    text-wrap: balance;
  }
  .signal {
    border-top: var(--hairline) solid var(--raster);
    border-bottom: var(--hairline) solid var(--raster);
  }
  canvas {
    width: 100%;
    height: clamp(330px, 52vh, 560px);
    touch-action: pan-y;
    cursor: crosshair;
  }
  canvas:focus-visible {
    outline-offset: -3px;
  }
  .readout {
    padding-top: 0.9rem;
    padding-bottom: clamp(2rem, 6vh, 4rem);
  }
  .werte {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.4rem;
  }
  .werte b {
    font-weight: 500;
    color: var(--graphit);
    display: inline-block;
    min-width: 5.2ch;
  }
  .hinweis {
    margin-top: 0.9rem;
    color: var(--blei);
    font-size: var(--s0);
  }
  @media (max-width: 900px) {
    .hero-head {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      column-gap: 1.1rem;
      row-gap: 1.4rem;
    }
    .hero-head .axis {
      grid-row: 1;
      align-self: center;
    }
    .ident {
      grid-column: 2;
      align-self: center;
    }
    .kernsatz {
      grid-column: 1 / -1;
      margin-top: 0.3rem;
    }
  }
</style>

<script>
  import { mountSignal } from '../scripts/signal';
  const canvas = document.querySelector<HTMLCanvasElement>('[data-signal]');
  const ro = (n: string) => document.querySelector<HTMLElement>(`[data-ro="${n}"]`);
  if (canvas) {
    mountSignal(canvas, {
      values: [ro('v0'), ro('v1'), ro('v2')],
      events: ro('events'),
      log: ro('log'),
    });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const h = document.querySelector('.hinweis');
      if (h)
        h.textContent =
          'Synthetische Signale als Standbild, da reduzierte Bewegung eingestellt ist. Die Erkennung, ein gleitender Mittelwert mit Toleranzband je Kanal, lief lokal im Browser.';
    }
  }
</script>
